{% comment %} Captain Coffee — Captain's Box promo strip {% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .cc-sampler h2 {
    color: {{ section.settings.heading_color | default: '#ffffff' }};
  }
  #shopify-section-{{ section.id }} .cc-sampler p {
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }
  {% if section.settings.use_custom_bg %}
  #shopify-section-{{ section.id }} .cc-sampler {
    background-color: {{ section.settings.custom_bg }};
  }
  {% endif %}
{% endstyle %}

<section class="cc-sampler">
  <div class="cc-wrap cc-sampler-inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="cc-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="cc-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Captain's Box Strip",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Sampler"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE CAPTAIN'S BOX"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "use_custom_bg",
      "label": "Use custom background (overrides seasonal color)",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_bg",
      "label": "Custom background color",
      "default": "#E23A2E"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Can't pick just one? Nobody can. Get four rotating blends in one box and find your coffee alter ego. The perfect gift for the hero in your life — or a very good excuse to treat yourself."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Grab the Box"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Captain's Box Strip"
    }
  ]
}
{% endschema %}
