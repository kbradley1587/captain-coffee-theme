{% comment %} Captain Coffee — team hero cards with photo pickers {% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .cc-team-title {
    color: {{ section.settings.heading_color | default: '#191428' }};
    text-shadow: 3px 3px 0 {{ section.settings.heading_shadow | default: '#FFC629' }};
  }
{% endstyle %}

<section class="cc-team cc-wrap">
  <h2 class="cc-team-title">{{ section.settings.heading }}</h2>
  <div class="cc-team-grid">
    {%- for block in section.blocks -%}
      <article class="cc-team-card" {{ block.shopify_attributes }}>
        <div class="cc-team-top" style="background-color: {{ block.settings.band_color | default: '#F7C8C0' }};"></div>
        <div class="cc-avatar">
          {%- if block.settings.photo != blank -%}
            <img src="{{ block.settings.photo | image_url: width: 300 }}" alt="{{ block.settings.name | escape }}" width="{{ block.settings.photo.width }}" height="{{ block.settings.photo.height }}" loading="lazy">
          {%- else -%}
            <span aria-hidden="true">👤</span>
          {%- endif -%}
        </div>
        {%- if block.settings.role != blank -%}
          <div class="cc-role-tag">{{ block.settings.role }}</div>
        {%- endif -%}
        <h3>{{ block.settings.name }}</h3>
        <p>{{ block.settings.bio }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>

<style>
  .cc-team{padding:1.6rem 0 7.2rem}
  .cc-team-title{font-family:var(--cc-display);font-weight:400;font-size:clamp(3.2rem,4.5vw,5rem);text-align:center;margin:0 0 4rem}
  .cc-team-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(25rem,1fr));gap:2.8rem}
  .cc-team-card{background:#fff;border:3px solid var(--cc-ink);box-shadow:6px 6px 0 var(--cc-ink);text-align:center;padding:0 0 2.4rem;transition:transform .15s ease,box-shadow .15s ease}
  .cc-team-card:hover{transform:translate(-3px,-3px);box-shadow:9px 9px 0 var(--cc-ink)}
  .cc-team-top{height:8.8rem;border-bottom:3px solid var(--cc-ink);background-image:radial-gradient(rgba(25,20,40,.14) 1.5px,transparent 2px);background-size:10px 10px}
  .cc-avatar{width:11rem;height:11rem;border-radius:50%;border:4px solid var(--cc-ink);background:var(--cc-paper-dark);display:grid;place-items:center;font-size:3.6rem;margin:-5.8rem auto 1.4rem;position:relative;z-index:2;box-shadow:4px 4px 0 var(--cc-ink);overflow:hidden}
  .cc-avatar img{width:100%;height:100%;object-fit:cover}
  .cc-role-tag{display:inline-block;font-family:var(--cc-display);font-size:1.4rem;letter-spacing:.08em;background:var(--cc-ink);color:var(--cc-yellow);padding:.25em .9em;transform:rotate(-1.5deg);margin-bottom:1rem}
  .cc-team-card h3{font-family:var(--cc-display);font-weight:400;font-size:2.4rem;line-height:1;margin:0 0 .2rem;color:var(--cc-ink)}
  .cc-team-card p{font-size:1.4rem;color:#3E3850;padding:0 2.2rem;margin:.8rem 0 0}
  @media (prefers-reduced-motion:reduce){.cc-team-card{transition:none}}
</style>

{% schema %}
{
  "name": "Comic Team",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the Crew" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#191428" },
    { "type": "color", "id": "heading_shadow", "label": "Heading shadow color", "default": "#FFC629" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "color", "id": "band_color", "label": "Top band color", "default": "#F7C8C0" },
        { "type": "text", "id": "role", "label": "Role", "default": "Co-Founder" },
        { "type": "text", "id": "name", "label": "Name", "default": "Name" },
        { "type": "textarea", "id": "bio", "label": "Bio", "default": "A short bio goes here." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Comic Team", "blocks": [{ "type": "member" }, { "type": "member" }, { "type": "member" }] }
  ]
}
{% endschema %}
