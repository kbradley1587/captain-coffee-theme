{% comment %}
  Captain Coffee — Comic Popup
  Site-wide announcement popup. Add this section to the HEADER group in the
  theme editor so it appears on every page.
  Shapes: comic panel / starburst / speech bubble.
  "Announcement version": change it (v1 → v2) to re-show the popup to
  visitors who already dismissed an earlier announcement.
{% endcomment %}

{%- if section.settings.enabled -%}
{% style %}
  #cc-popup-{{ section.id }} .cc-popup-box {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#191428' }};
  }
  #cc-popup-{{ section.id }} .cc-popup-heading {
    color: {{ section.settings.heading_color | default: '#191428' }};
    text-shadow: 3px 3px 0 {{ section.settings.heading_shadow | default: '#FFC629' }};
  }
  #cc-popup-{{ section.id }} .cc-popup-btn {
    background: {{ section.settings.button_bg | default: '#E23A2E' }};
    color: {{ section.settings.button_color | default: '#ffffff' }};
  }
  #cc-popup-{{ section.id }} .cc-popup-eyebrow {
    background: {{ section.settings.accent_color | default: '#E23A2E' }};
  }
  #cc-popup-{{ section.id }} .cc-popup-burst polygon {
    fill: {{ section.settings.accent_color | default: '#FFC629' }};
  }
  #cc-popup-{{ section.id }} .cc-popup-box--bubble::after {
    border-top-color: {{ section.settings.bg_color | default: '#ffffff' }};
  }
{% endstyle %}

<div id="cc-popup-{{ section.id }}" class="cc-popup-overlay" hidden role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
  <div class="cc-popup-wrap cc-popup-wrap--{{ section.settings.shape }}">
    {%- if section.settings.shape == 'starburst' -%}
      <svg class="cc-popup-burst" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polygon points="50,0 60,12 75,4 78,19 94,17 89,31 100,39 89,50 100,61 89,69 94,83 78,81 75,96 60,88 50,100 40,88 25,96 22,81 6,83 11,69 0,61 11,50 0,39 11,31 6,17 22,19 25,4 40,12" stroke="#191428" stroke-width="1.2"/>
      </svg>
    {%- endif -%}
    <div class="cc-popup-box cc-popup-box--{{ section.settings.shape }}">
      <button type="button" class="cc-popup-close" aria-label="Close">&times;</button>
      {%- if section.settings.image != blank -%}
        <img class="cc-popup-img" src="{{ section.settings.image | image_url: width: 480 }}" alt="{{ section.settings.image.alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <span class="cc-popup-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cc-popup-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="cc-popup-text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="cc-popup-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .cc-popup-overlay{
    position:fixed;inset:0;z-index:9999;display:grid;place-items:center;
    background:rgba(25,20,40,.62);padding:2rem;
  }
  .cc-popup-overlay[hidden]{display:none}
  .cc-popup-wrap{position:relative;max-width:44rem;width:100%;animation:ccPopIn .35s cubic-bezier(.2,1.5,.4,1) both}
  .cc-popup-wrap--starburst{max-width:52rem;padding:6rem 5rem}
  .cc-popup-burst{position:absolute;inset:0;width:100%;height:100%;filter:drop-shadow(6px 6px 0 rgba(25,20,40,.55))}
  .cc-popup-box{
    position:relative;border:3px solid #191428;box-shadow:8px 8px 0 #191428;
    padding:3rem 2.6rem 2.8rem;text-align:center;
    background-image:radial-gradient(rgba(25,20,40,.06) 1px, transparent 1.4px);
    background-size:8px 8px;
  }
  .cc-popup-box--bubble{border-radius:2.4rem}
  .cc-popup-box--bubble::after{
    content:"";position:absolute;bottom:-2.1rem;left:18%;
    border:1.2rem solid transparent;border-top-width:2.2rem;
    filter:drop-shadow(0 3px 0 #191428);
  }
  .cc-popup-wrap--starburst .cc-popup-box{border:0;box-shadow:none;background:transparent}
  .cc-popup-close{
    position:absolute;top:-1.4rem;right:-1.4rem;width:3.6rem;height:3.6rem;
    border-radius:50%;border:3px solid #191428;background:#fff;color:#191428;
    font-size:2rem;line-height:1;cursor:pointer;box-shadow:3px 3px 0 #191428;z-index:2;
  }
  .cc-popup-wrap--starburst .cc-popup-close{top:.4rem;right:.4rem}
  .cc-popup-img{max-width:16rem;height:auto;margin:0 auto 1.2rem;filter:drop-shadow(4px 4px 0 rgba(25,20,40,.4))}
  .cc-popup-eyebrow{
    display:inline-block;font-family:'Bangers',cursive;font-size:1.4rem;letter-spacing:.1em;
    color:#fff;padding:.25em 1em;border:3px solid #191428;transform:rotate(-2deg);
    box-shadow:3px 3px 0 #191428;margin-bottom:1.2rem;
  }
  .cc-popup-heading{font-family:'Bangers',cursive;font-weight:400;font-size:clamp(2.6rem,5vw,4rem);line-height:1;margin:0 0 1rem;letter-spacing:.03em}
  .cc-popup-text{font-family:'Archivo',sans-serif;font-size:1.5rem;font-weight:600;margin-bottom:1.8rem}
  .cc-popup-text p{margin:0 0 .6em}
  .cc-popup-btn{
    display:inline-block;font-family:'Bangers',cursive;font-size:1.9rem;letter-spacing:.06em;
    padding:.6em 1.5em;border:3px solid #191428;text-decoration:none;
    box-shadow:5px 5px 0 #191428;transition:transform .12s ease, box-shadow .12s ease;
  }
  .cc-popup-btn:hover{transform:translate(-2px,-2px);box-shadow:7px 7px 0 #191428}
  @keyframes ccPopIn{from{transform:scale(.7);opacity:0}to{transform:scale(1);opacity:1}}
  @media (max-width:620px){
    .cc-popup-wrap--starburst{padding:4.5rem 3rem}
    .cc-popup-close{top:.6rem;right:.6rem}
  }
  @media (prefers-reduced-motion:reduce){.cc-popup-wrap{animation:none}}
</style>

<script>
(function(){
  var el = document.getElementById('cc-popup-{{ section.id }}');
  if (!el) return;
  var key = 'cc-popup-{{ section.id }}-{{ section.settings.version | default: "v1" | escape }}';
  var freq = {{ section.settings.frequency | json }};
  var delay = {{ section.settings.delay | default: 3 }} * 1000;
  var design = window.Shopify && Shopify.designMode;

  function seen(){
    try{
      if (freq === 'always') return false;
      if (freq === 'session') return sessionStorage.getItem(key) === '1';
      return localStorage.getItem(key) === '1';
    }catch(e){ return false; }
  }
  function markSeen(){
    try{
      if (freq === 'session') sessionStorage.setItem(key,'1');
      else if (freq !== 'always') localStorage.setItem(key,'1');
    }catch(e){}
  }
  function close(){ el.hidden = true; markSeen(); }

  el.addEventListener('click', function(e){
    if (e.target === el || e.target.closest('.cc-popup-close')) close();
  });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !el.hidden) close(); });

  if (design) {
    el.hidden = false; // always visible while editing in the theme editor
  } else if (!seen()) {
    setTimeout(function(){ el.hidden = false; }, delay);
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Comic Popup",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show popup", "default": false },
    {
      "type": "select", "id": "shape", "label": "Popup shape",
      "options": [
        { "value": "panel", "label": "Comic panel" },
        { "value": "starburst", "label": "Starburst" },
        { "value": "bubble", "label": "Speech bubble" }
      ],
      "default": "panel"
    },
    { "type": "range", "id": "delay", "min": 0, "max": 15, "step": 1, "unit": "s", "label": "Delay before showing", "default": 3 },
    {
      "type": "select", "id": "frequency", "label": "Show frequency",
      "options": [
        { "value": "once", "label": "Once per visitor" },
        { "value": "session", "label": "Once per visit (session)" },
        { "value": "always", "label": "Every page load" }
      ],
      "default": "once"
    },
    { "type": "text", "id": "version", "label": "Announcement version", "info": "Change this (v1 → v2) to show a new announcement to everyone, including visitors who closed an old one.", "default": "v1" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Badge text", "default": "NEW!" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BIG NEWS, CREW!" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A brand new blend has landed. Be the first to try it.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Check It Out" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Popup background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#191428" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#191428" },
    { "type": "color", "id": "heading_shadow", "label": "Heading shadow color", "default": "#FFC629" },
    { "type": "color", "id": "accent_color", "label": "Accent color (badge / starburst)", "default": "#E23A2E" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#E23A2E" },
    { "type": "color", "id": "button_color", "label": "Button text", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "Comic Popup" }
  ]
}
{% endschema %}
