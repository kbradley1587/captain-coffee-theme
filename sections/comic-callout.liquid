{% comment %} Captain Coffee — callout panel with optional speech bubble (characters / CTA) {% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .cc-callout {
    background-color: {{ section.settings.bg_color | default: '#2B5FAD' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }
  #shopify-section-{{ section.id }} .cc-callout h2 {
    color: {{ section.settings.heading_color | default: '#ffffff' }};
  }
  #shopify-section-{{ section.id }} .cc-callout-btn {
    background: {{ section.settings.button_bg | default: '#FFC629' }};
    color: {{ section.settings.button_color | default: '#191428' }};
  }
{% endstyle %}

<section class="cc-callout-wrap cc-wrap">
  <div class="cc-callout">
    {%- if section.settings.bubble_text != blank -%}
      <div class="cc-speech">{{ section.settings.bubble_text }}</div>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="cc-callout-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

<style>
  .cc-callout-wrap{padding:6.4rem 2.4rem}
  .cc-callout{
    position:relative;text-align:center;border:4px solid var(--cc-ink);box-shadow:10px 10px 0 var(--cc-ink);
    padding:clamp(3.6rem,5vw,6rem);
    background-image:radial-gradient(rgba(255,255,255,.2) 2px,transparent 2.6px);background-size:12px 12px;
  }
  .cc-callout h2{font-family:var(--cc-display);font-weight:400;font-size:clamp(3.2rem,4.5vw,5rem);text-shadow:3px 3px 0 var(--cc-ink);margin:0 0 1.2rem}
  .cc-callout p{max-width:58ch;margin:0 auto 2.6rem;font-weight:600;font-size:1.6rem;text-shadow:1px 1px 0 rgba(0,0,0,.3)}
  .cc-speech{
    position:absolute;top:-1.8rem;right:6%;background:#fff;color:var(--cc-ink);border:3px solid var(--cc-ink);
    font-family:var(--cc-display);font-size:1.7rem;padding:.35em 1em;border-radius:1.8rem;
    box-shadow:4px 4px 0 var(--cc-ink);transform:rotate(3deg);
  }
  .cc-speech::after{content:"";position:absolute;bottom:-1.4rem;left:2.4rem;border:.8rem solid transparent;border-top-color:var(--cc-ink)}
  .cc-callout-btn{
    display:inline-block;font-family:var(--cc-display);font-size:1.9rem;letter-spacing:.06em;
    padding:.65em 1.5em;border:3px solid var(--cc-ink);text-decoration:none;
    box-shadow:5px 5px 0 var(--cc-ink);transition:transform .12s ease,box-shadow .12s ease;
  }
  .cc-callout-btn:hover{transform:translate(-2px,-2px);box-shadow:7px 7px 0 var(--cc-ink)}
  @media(max-width:620px){
    .cc-speech{position:static;display:inline-block;margin-bottom:1.6rem;transform:rotate(-1deg)}
    .cc-speech::after{display:none}
  }
  @media (prefers-reduced-motion:reduce){.cc-callout-btn{transition:none}}
</style>

{% schema %}
{
  "name": "Comic Callout",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "bubble_text", "label": "Speech bubble text (optional)", "default": "Ready to chat?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "MEET OUR COFFEE CHARACTERS" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From pirate treasure to galaxy-grade dark roasts, each coffee has a voice. Get to know the personality in your cup before you ever brew it." },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "bg_color", "label": "Panel background", "default": "#2B5FAD" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Visit the Store" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#FFC629" },
    { "type": "color", "id": "button_color", "label": "Button text", "default": "#191428" }
  ],
  "presets": [{ "name": "Comic Callout" }]
}
{% endschema %}
